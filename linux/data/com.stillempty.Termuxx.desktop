[Desktop Entry]
Type=Application
Name=Termuxx
GenericName=Terminal and SSH client
GenericName[ru]=Терминал и SSH-клиент
Comment=Terminal with tabs and SSH server manager: SFTP, monitoring, tunnels
Comment[ru]=Терминал с вкладками и менеджер SSH-серверов: SFTP, мониторинг, туннели
Exec=termuxx %U
Icon=com.stillempty.Termuxx
Terminal=false
StartupNotify=true
StartupWMClass=com.stillempty.Termuxx
Categories=System;TerminalEmulator;Network;RemoteAccess;GTK;
Keywords=terminal;ssh;sftp;shell;server;vps;терминал;сервер;
MimeType=x-scheme-handler/ssh;
Actions=new-window;quick-connect;

[Desktop Action new-window]
Name=New Window
Name[ru]=Новое окно
Exec=termuxx --new-window

[Desktop Action quick-connect]
Name=Local Terminal
Name[ru]=Локальный терминал
Exec=termuxx
